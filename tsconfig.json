{
  "extends": "./node_modules/pcf-scripts/tsconfig_base.json",
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types"
    ],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "jsxFactory": "React.createElement",
    "jsxFragmentFactory": "React.Fragment"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "generated/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "PCFInitTest",
    "CopilotSolution"
  ]
}
